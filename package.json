    "test:visual:webkit": "set PW_ENGINE=webkit&& node scripts/visual-iteration-08.mjs",
    "test:visual:iteration07": "node scripts/visual-iteration-07.mjs",
    "test:iteration09": "node scripts/test-iteration-09-navigation.mjs",
    "test:iteration12:mobile": "node scripts/visual-iteration-12-mobile-polish.mjs",
    "test:iteration12:day-system": "node scripts/visual-iteration-12-day-system.mjs",
    "test:iteration12:iphone17": "node scripts/visual-iteration-12-iphone17.mjs",
    "test:iteration12:final-micro": "node scripts/visual-iteration-12-final-micro-polish.mjs"
  },
  "dependencies": {
    "geist": "1.7.2",
    "motion": "12.43.0",
    "next": "16.2.12",
